            const runWrite = async (body) => {
                const versusPathConfigWrite = __dirname+'/versus/'
                const fileRead = await fs.readFileSync(versusPathConfigWrite+'config.json')
                const fileNameToTunnel = JSON.parse(fileRead.toString())
                try{
                  const res = await fetch(`${fileNameToTunnel.tunnel}/write`, {
                        method: 'post',
                        body: JSON.stringify({ msg: body, allowedOrigins: allowedOrigins })
                    });
                    const val = await res.json()
                    console.log('written to '+ fileNameToTunnel.tunnel)
                    return val  
                }catch(err){
                    console.log('bad tunnel endpoint or server not running')
                    throw new Error(err)
                }
            };
            const promise = () => new Promise((res) => {
                fs.readFile(fp , async (err, data) => {
