                    const fileRead = await fs.readFileSync(versusPathConfigKey+'config.json')
                    const fileNameToAuthor = JSON.parse(fileRead.toString())

                    const writingObj = {
                        code: JSON.stringify(data.toString()),
                        author: fileNameToAuthor.key,
                        bundleID: fp.split('/')[fp.split('/').length -1 ].split('.js')[0]
                    }
                    
                    console.log(await runWrite(writingObj))
                    res()
                })
            })
            try{
                await promise();
            }catch(err){
